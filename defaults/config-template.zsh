# usagi-cli-banner configuration
# Uncomment and modify options as needed.
# This file is sourced by zsh — use shell variable syntax.

# --- Theme ---
# Available: pink (default), ocean, forest, mono
# _usagi_theme="pink"

# --- Custom colors (override theme) ---
# Use ANSI 256-color codes: $'\e[38;5;NNm'
# _usagi_color_art=$'\e[38;5;199m'
# _usagi_color_label=$'\e[38;5;218m'
# _usagi_color_value=$'\e[38;5;255m'
# _usagi_color_quote=$'\e[38;5;183m'
# _usagi_color_separator=$'\e[38;5;218m'

# --- Info toggles ---
# Set to "false" to hide a field
# _usagi_show_date=true
# _usagi_show_host=true
# _usagi_show_uptime=true
# _usagi_show_shell=true
# _usagi_show_os=true
# _usagi_show_cpu=false
# _usagi_show_memory=false

# --- Custom files ---
# Override default art or quotes with your own files
# _usagi_art_file="$HOME/.config/usagi/ascii-art.txt"
# _usagi_quotes_file="$HOME/.config/usagi/quotes.txt"

# --- Layout ---
# Separator between label and value
# _usagi_separator=" ~ "

# --- Misc ---
# Set to "false" to disable the quote line
# _usagi_show_quote=true
